---
interface Props {
  title: string;
  summary: string;
}

const { title, summary } = Astro.props;
---

<li>
  <span class="title">{title}</span>
  <span class="summary">{summary}</span>
</li>

<style>
  li {
    padding: var(--space-3) 0;
  }

  li + li {
    border-top: 1px solid var(--rule);
  }

  .title {
    font-weight: 700;
    /* Astro collapses the whitespace between the two adjacent spans, so the
       gap has to come from CSS or the title runs into the summary. */
    margin-right: 0.6em;
  }

  .summary {
    font-size: var(--body-sm);
    color: var(--mute);
  }
</style>
