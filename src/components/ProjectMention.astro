---
interface Props {
  title: string;
  summary: string;
}

const { title, summary } = Astro.props;
---

<li>
  <h3>{title}</h3>
  <p>{summary}</p>
</li>

<style>
  li {
    padding: 20px;
    min-width: 0;
  }

  h3 {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 8px;
  }

  p {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--mute);
    margin: 0;
  }
</style>
