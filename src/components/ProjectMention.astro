---
interface Props {
  title: string;
  summary: string;
}

const { title, summary } = Astro.props;
---

<li>
  <h3>{title}</h3>
  <p class="summary">{summary}</p>
</li>

<style>
  /* Same anatomy as ProjectCard so the two sections read as one system. */
  li {
    min-width: 0;
    padding: var(--space-4);
  }

  h3 {
    font-size: var(--heading);
    line-height: 1.3;
  }

  .summary {
    margin-top: var(--space-2);
    font-size: var(--body-sm);
    line-height: 1.6;
    color: var(--mute);
  }
</style>
