---
import Panel from './Panel.astro';

const email = 'mailto:iemrani@icloud.com';
const githubUrl = 'https://github.com/iemrani';
---

<div class="hero">
  <div>
    <h1>I build LLM applications that run in production.</h1>
    <p class="lead">
      And I work directly with the people who use them.
    </p>
    <p class="sub">
      Code on <a href={githubUrl}>github.com/iemrani</a>.
    </p>
    <div class="btns">
      <a class="btn p" href="#work">&#9656; see the work</a>
      <a class="btn s" href={email}>get in touch &rarr;</a>
    </div>
    <p class="status"><i></i>available for roles in Italy and remote contract</p>
  </div>

  <Panel />
</div>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    padding: 70px 0 60px;
    border-bottom: 1px dashed var(--rule);
  }

  .hero > div {
    min-width: 0;
  }

  h1 {
    font-size: 52px;
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -1px;
    margin: 0 0 22px;
  }

  .lead {
    max-width: 44ch;
    margin: 0 0 16px;
  }

  .sub {
    max-width: 44ch;
    margin: 0 0 28px;
    color: var(--mute);
  }

  .btns {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    padding: 11px 16px;
    text-decoration: none;
    border-radius: 0;
    min-height: 44px;
  }

  .btn.p {
    background: var(--ink);
    color: var(--paper);
    border: 0;
  }

  .btn.s {
    background: var(--paper);
    color: var(--ink);
    border: 1.5px solid var(--ink);
  }

  .status {
    font-size: 11.5px;
    color: var(--mute);
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin: 0;
  }

  .status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
    flex: 0 0 7px;
    margin-top: 6px;
  }

  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 52px 0 44px;
    }

    h1 {
      font-size: 40px;
    }
  }

  @media (max-width: 767px) {
    h1 {
      font-size: 34px;
      letter-spacing: -0.6px;
    }
  }
</style>
