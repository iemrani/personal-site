---
interface Props {
  title: string;
  summary: string;
  tech?: string;
  url: string;
  repo?: string;
}

const { title, summary, tech, url, repo } = Astro.props;
---

<article>
  <h3><a href={url}>{title}</a></h3>
  <p class="summary">{summary}</p>
  {tech && <p class="tech">{tech}</p>}
  <p class="links">
    <a href={url}>overview and live app</a>
    {repo && <> &middot; <a href={repo}>source</a></>}
  </p>
</article>

<style>
  /* card-row member: no radius, no shadow, divided by the parent's rules */
  article {
    min-width: 0;
    padding: var(--space-4);
  }

  h3 {
    font-size: var(--heading);
    line-height: 1.3;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .summary {
    max-width: 72ch;
    margin-top: var(--space-2);
    font-size: var(--body-sm);
    line-height: 1.6;
    color: var(--mute);
  }

  .tech {
    margin-top: var(--space-3);
    font-size: var(--label);
    color: var(--accent);
  }

  .links {
    margin-top: var(--space-2);
    font-size: var(--label);
  }
</style>
