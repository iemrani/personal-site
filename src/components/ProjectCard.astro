---
interface Props {
  title: string;
  summary: string;
  tech?: string;
  url: string;
  repo?: string;
}

const { title, summary, tech, url, repo } = Astro.props;
---

<article>
  <h3><a href={url}>{title}</a></h3>
  <p>{summary}</p>
  {tech && <p class="meta">{tech}</p>}
  <p class="meta">
    <a href={url}>overview and live app</a>
    {repo && <> &middot; <a href={repo}>source</a></>}
  </p>
</article>

<style>
  article {
    padding: 20px;
    min-width: 0;
  }

  h3 {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 8px;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  p {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--mute);
    margin: 0 0 14px;
  }

  .meta {
    font-size: 11px;
    color: var(--blue);
    margin: 0;
  }

  .meta + .meta {
    margin-top: 6px;
  }
</style>
