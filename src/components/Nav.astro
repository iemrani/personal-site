---
const email = 'mailto:iemrani@icloud.com';
---

<nav>
  <span class="mark">IE</span>
  <a class="nl" href="#work">work</a>
  <a class="nl" href="#also-built">also built</a>
  <a class="nl" href="#stack">stack</a>
  <a class="nl" href="#contact">contact</a>
  <span class="spacer"></span>
  <a class="btn p" href={email}>email me &rsaquo;</a>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 16px 0;
    border-bottom: 1px dashed var(--rule);
    flex-wrap: wrap;
  }

  .mark {
    width: 30px;
    height: 26px;
    border: 2px solid var(--ink);
    border-radius: 6px;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 12px;
  }

  .nl {
    color: var(--ink);
    text-decoration: none;
    font-size: 12.5px;
  }

  .nl:hover {
    text-decoration: underline;
  }

  .spacer {
    margin-left: auto;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    padding: 8px 13px;
    text-decoration: none;
    border-radius: 0;
  }

  .btn.p {
    background: var(--ink);
    color: var(--paper);
    border: 0;
  }

  @media (max-width: 767px) {
    nav {
      gap: 14px;
    }
  }
</style>
