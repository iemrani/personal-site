---
// The reference page's data panel, kept as an empty shell.
// Its contents are deliberately undecided: it will hold something real.
---

<div class="panel">
  <div class="head">
    <span class="micro">placeholder</span>
    <span class="micro">to be decided</span>
  </div>
  <div class="body">
    <p class="micro">This box is reserved. Tell me what goes here.</p>
  </div>
</div>

<style>
  .panel {
    background: #fff;
    border: 1px solid var(--rule);
    align-self: start;
    min-width: 0;
  }

  .head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 12px;
    border-bottom: 1px solid var(--rule);
  }

  .body {
    display: grid;
    place-items: center;
    min-height: 240px;
    padding: 16px 14px;
  }

  .body p {
    margin: 0;
  }
</style>
