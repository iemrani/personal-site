---
const links = [
  { label: 'GitHub', href: 'https://github.com/iemrani' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/iemrani' },
  { label: 'Email', href: 'mailto:iemrani@icloud.com' },
];
---

<footer>
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  footer {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }
</style>
