---
const links = [
  { label: 'github', href: 'https://github.com/iemrani' },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/iemrani' },
  { label: 'email', href: 'mailto:iemrani@icloud.com' },
];
---

<footer id="contact">
  <p>
    {
      links.map((link, index) => (
        <>
          {index > 0 && <span> &middot; </span>}
          <a href={link.href}>{link.label}</a>
        </>
      ))
    }
  </p>
  <p class="colophon">&copy; 2026 &middot; built and maintained by hand</p>
</footer>

<style>
  footer {
    padding: 28px 0 56px;
    font-size: 11.5px;
    color: var(--mute);
  }

  p {
    margin: 0;
  }

  .colophon {
    margin-top: 8px;
  }
</style>
