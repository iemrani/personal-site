---
const githubUrl = 'https://github.com/iemrani';
---

<header>
  <h1>«FILL: full name»</h1>
  <p class="positioning">
    AI and LLM engineer. I build LLM applications that run in production, and I
    work directly with the people who use them.
  </p>
  <p class="authorisation">
    Authorised to work in Italy. Available worldwide as a remote contractor.
  </p>
  <p class="contact"><a href={githubUrl}>github.com/iemrani</a></p>
</header>

<style>
  header {
    margin-bottom: var(--space-5);
  }

  h1 {
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }

  .positioning {
    margin-top: var(--space-2);
    font-size: var(--step-1);
    color: var(--text);
  }

  .authorisation {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .contact {
    margin-top: var(--space-1);
    font-size: var(--step--1);
  }
</style>
