---
const email = 'mailto:iemrani@icloud.com';
const githubUrl = 'https://github.com/iemrani';
---

<header>
  <p class="eyebrow">Iman Emrani &middot; AI and LLM engineer</p>
  <h1>I build LLM applications that run in production.</h1>
  <p class="lead">
    And I work directly with the people who use them.
  </p>
  <p class="sub">
    Code on <a href={githubUrl}>github.com/iemrani</a>.
  </p>
  <div class="btns">
    <a class="btn p" href="#work">&#9656; see the work</a>
    <a class="btn s" href={email}>get in touch &rarr;</a>
  </div>
  <p class="status">
    <i aria-hidden="true"></i>Authorised to work in Italy. Available worldwide as
    a remote contractor.
  </p>
</header>

<style>
  header {
    padding: 70px 0 60px;
    border-bottom: 1px dashed var(--rule);
  }

  .eyebrow {
    margin-bottom: var(--space-4);
    font-size: var(--micro);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--mute);
  }

  h1 {
    font-size: var(--display);
    letter-spacing: -1px;
    line-height: 1.04;
  }

  .lead {
    margin-top: var(--space-4);
    max-width: var(--measure);
  }

  .sub {
    margin-top: var(--space-3);
    max-width: var(--measure);
    color: var(--mute);
  }

  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--space-5);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 11px 16px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .btn.p {
    background: var(--ink);
    color: var(--paper);
  }

  .btn.s {
    background: var(--paper);
    color: var(--ink);
    border: 1.5px solid var(--ink);
  }

  /* status-line component, brief section Components */
  .status {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin-top: var(--space-3);
    max-width: var(--measure);
    font-size: var(--caption);
    color: var(--mute);
  }

  .status i {
    flex: 0 0 7px;
    width: 7px;
    height: 7px;
    margin-top: 6px;
    border-radius: 50%;
    background: var(--ink);
  }

  @media (max-width: 767px) {
    header {
      padding: 44px 0 40px;
    }

    h1 {
      letter-spacing: -0.6px;
    }
  }
</style>
