---
const githubUrl = 'https://github.com/iemrani';
---

<header>
  <h1>Iman Emrani</h1>
  <p class="positioning">
    AI and LLM engineer. I build LLM applications that run in production, and I
    work directly with the people who use them.
  </p>
  <p class="status">
    <i aria-hidden="true"></i>Authorised to work in Italy. Available worldwide as
    a remote contractor.
  </p>
  <p class="contact"><a href={githubUrl}>github.com/iemrani</a></p>
</header>

<style>
  header {
    padding: 70px 0 60px;
    border-bottom: 1px dashed var(--rule);
  }

  h1 {
    font-size: var(--display);
    letter-spacing: -1px;
    line-height: 1.04;
  }

  .positioning {
    margin-top: var(--space-4);
    max-width: var(--measure);
  }

  /* status-line component, brief section Components */
  .status {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin-top: var(--space-3);
    font-size: var(--caption);
    color: var(--mute);
    max-width: var(--measure);
  }

  .status i {
    flex: 0 0 7px;
    width: 7px;
    height: 7px;
    margin-top: 6px;
    border-radius: 50%;
    background: var(--ink);
  }

  .contact {
    margin-top: var(--space-3);
    font-size: var(--body-sm);
  }

  @media (max-width: 767px) {
    header {
      padding: 44px 0 40px;
    }

    h1 {
      letter-spacing: -0.6px;
    }
  }
</style>
