---
// Booking page. Blueprint frame + a Cal.com inline embed.
// The only thing to change after creating the Cal.com account is CAL_USER below,
// and the three `slug` values if the event types are named differently there.
import Layout from '../layouts/Layout.astro';

const CAL_USER = 'iemrani';

const sessions = [
  {
    slug: 'intro',
    name: 'First call',
    len: '20 min',
    cost: 'free',
    desc: 'A first conversation. What you are building, what is in the way, whether I am the right person for it.',
  },
  {
    slug: 'consultation',
    name: 'Consultation',
    len: '60 min',
    cost: '\u20ac120',
    desc: 'A working session on a specific problem: an agent that misbehaves, an LLM feature you are scoping, a pipeline that keeps breaking. You leave with a plan.',
  },
];
---

<Layout
  title="Book a call · Iman Emrani"
  description="Book an intro call, a paid consultation, or a technical interview with Iman Emrani, AI and LLM engineer."
>
<Fragment slot="head">
  {/*
    The calendar is three sequential hops to a cold origin: embed.js, then the
    iframe page, then Cal's own app fetching availability inside it. Only the
    first two are ours to speed up. The preconnect gets DNS and TLS out of the
    way before any of it runs, and the preload starts embed.js downloading
    during head parsing instead of after the body script at the foot of the page.
    No `crossorigin` on the preload: the loader injects a plain <script>, and a
    mismatched mode would make the browser fetch the file twice.
  */}
  <link rel="preconnect" href="https://app.cal.com" />
  <link rel="preload" as="script" href="https://app.cal.com/embed/embed.js" />
</Fragment>
<div class="wrap">

  <nav>
    <a class="mark" href="/">IE</a>
    <a class="nl" href="/#work">work</a>
    <a class="nl" href="/#about">about</a>
    <a class="nl" href="/#contact">contact</a>
    <span class="spacer"></span>
    <a class="nl back" href="/">&larr; back to the site</a>
  </nav>

  <header class="top">
    <h1>Book a call.</h1>
    <p class="lead">Pick the kind of conversation you want. Times are shown in your own timezone; I am in Europe/Rome and work with people outside it every week.</p>
  </header>

  <section class="picker">
    <p class="label">Session types</p>
    <div class="panel">
      <div class="head">
        <span class="micro">choose one</span>
        <span class="micro">2 types</span>
      </div>
      <div class="rows">
        {sessions.map((s, i) => (
          <button
            class:list={['row', 'srow', { on: i === 0 }]}
            type="button"
            data-slug={s.slug}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <span class="nm"><i></i>{s.name}</span>
            <span class="sc">{s.len} &middot; {s.cost}</span>
            <span class="ds">{s.desc}</span>
          </button>
        ))}
      </div>
      <div class="note">The first call is free, with no obligation. A consultation is confirmed by me before it is booked, and invoiced after it.</div>
    </div>
  </section>

  <section class="cal">
    <p class="label">Pick a time</p>
    <div class="calframe">
      <div id="cal-inline"></div>
      <noscript>
        <p class="fallback">
          The calendar needs JavaScript. Turn it on, or message me on
          <a href="https://www.linkedin.com/in/iemrani">LinkedIn</a> and I will send times.
        </p>
      </noscript>
    </div>
  </section>

  <footer id="contact">
    <p class="label">Rather not book?</p>
    <div class="social">
      <a data-u="iman" data-d="iemrani.com">email</a>
      <a href="https://www.linkedin.com/in/iemrani">linkedin</a>
      <a href="https://github.com/iemrani">github</a>
    </div>
    <p class="fine">&copy; 2026 &middot; built and maintained by hand</p>
  </footer>
</div>

<script is:inline>
  // The address is assembled at runtime so it never appears in the page source.
  // This stops the harvesters that only read HTML; one driving a real browser
  // will still get it, and nothing prevents that.
  document.querySelectorAll('a[data-u][data-d]').forEach(function (a) {
    var addr = a.dataset.u + String.fromCharCode(64) + a.dataset.d;
    a.href = 'mail' + 'to:' + addr;
    if (a.dataset.show === 'addr') a.textContent = addr;
  });
</script>

<script is:inline define:vars={{ CAL_USER }}>
  // Cal.com embed loader. Lifted from Cal's official snippet, reformatted.
  (function (C, A, L) {
    var p = function (a, ar) { a.q.push(ar); };
    var d = C.document;
    C.Cal = C.Cal || function () {
      var cal = C.Cal;
      var ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement('script')).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        var api = function () { p(api, arguments); };
        var namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === 'string') {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ['initNamespace', namespace]);
        } else {
          p(cal, ar);
        }
        return;
      }
      p(cal, ar);
    };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  var host = document.getElementById('cal-inline');
  var rows = Array.prototype.slice.call(document.querySelectorAll('.srow'));
  var loaded = {};

  // Blueprint tokens, passed through so the embed does not look bolted on.
  // The embed is an iframe on cal.com's origin, so it follows the VISITOR's
  // system dark mode, not this page. Forcing theme:'light' is not enough on its
  // own, so the dark palette is defined identically to the light one: whichever
  // theme Cal decides to render, the colours are the Blueprint ones.
  var VARS = {
    'cal-brand': '#2323e6',
    'cal-bg': '#ffffff',
    'cal-bg-emphasis': '#faf9f7',
    'cal-bg-muted': '#faf9f7',
    'cal-border': '#e2e0da',
    'cal-border-emphasis': '#e2e0da',
    'cal-text': '#14140f',
    'cal-text-emphasis': '#14140f',
    'cal-text-subtle': '#6b6a63',
    'cal-text-muted': '#6b6a63',
  };

  var UI = {
    cssVarsPerTheme: { light: VARS, dark: VARS },
    hideEventTypeDetails: false,
    layout: 'month_view',
    theme: 'light',
  };

  // Cal's inline embed ships two loading states and picks between them on this
  // value alone: with a pageType it draws the full booker skeleton (meta column
  // and a month grid), without one it draws a bare 30px spinner. The spinner in
  // a 620px white frame is what reads as "nothing is happening", so name the
  // page type. The two Cal accepts are user.* and team.*; this is a user account.
  var PAGE_TYPE = 'user.event.booking.slots';

  var inited = {};
  function ns(slug) {
    if (!inited[slug]) {
      Cal('init', slug, { origin: 'https://app.cal.com' });
      inited[slug] = true;
    }
    return Cal.ns[slug];
  }

  function show(slug) {
    // One Cal namespace per session type. Initialise on first use, then just
    // toggle visibility, so switching back is instant and never re-fetches.
    Object.keys(loaded).forEach(function (k) {
      loaded[k].hidden = k !== slug;
    });
    if (loaded[slug]) return;

    var box = document.createElement('div');
    box.className = 'cal-slot pinned';
    host.appendChild(box);
    loaded[slug] = box;

    // Release the height lock when Cal says the booker has painted, and on a
    // timer as well: a lock left on by an embed that never reports ready would
    // clip the calendar, and Cal hides the scrollbar inside that container, so
    // the clipped part would be unreachable. Failing open is the safe side.
    var unpin = function () { box.classList.remove('pinned'); };
    ns(slug)('on', { action: 'linkReady', callback: unpin });
    setTimeout(unpin, 8000);

    ns(slug)('inline', {
      elementOrSelector: box,
      calLink: CAL_USER + '/' + slug,
      layout: 'month_view',
      config: { theme: 'light', 'cal.embed.pageType': PAGE_TYPE },
    });
    ns(slug)('ui', UI);
  }

  // Warm the session type the visitor did NOT land on, so picking it later does
  // not repeat the whole chain from cold. For an inline embed Cal's preload
  // loads the link in a hidden 0x0 iframe, which fills the browser cache with
  // the shared chunks; the second embed then only has its own HTML to fetch.
  // Held back until the first calendar is up so it never competes with it, and
  // skipped on metered or slow connections, where a 600KB speculative load is
  // a cost the visitor did not ask for.
  function warmTheRest(first) {
    var c = navigator.connection;
    if (c && (c.saveData || /2g/.test(c.effectiveType || ''))) return;
    rows.forEach(function (r) {
      var slug = r.dataset.slug;
      if (slug !== first) ns(slug)('preload', { calLink: CAL_USER + '/' + slug });
    });
  }

  rows.forEach(function (row) {
    row.addEventListener('click', function () {
      rows.forEach(function (r) {
        var on = r === row;
        r.classList.toggle('on', on);
        r.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      show(row.dataset.slug);
    });
  });

  var first = rows[0].dataset.slug;
  show(first);

  // linkReady is Cal's own "the calendar has painted" signal, the same one it
  // uses to drop its skeleton. The timer is the fallback for the case where it
  // never fires, so a broken first embed cannot leave the second one cold.
  var warmed = false;
  function warmOnce() {
    if (warmed) return;
    warmed = true;
    warmTheRest(first);
  }
  ns(first)('on', { action: 'linkReady', callback: warmOnce });
  setTimeout(warmOnce, 8000);
</script>

<style is:global>
:root{
  --paper:#faf9f7; --ink:#14140f; --mute:#6b6a63; --rule:#e2e0da;
  --dot:#d9d7d0; --blue:#2323e6; --col:128px;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0; background:var(--paper); color:var(--ink);
  font:400 13.5px/1.65 "JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;
  background-image:
    radial-gradient(var(--dot) 1px,transparent 1px),
    linear-gradient(90deg,var(--rule) 1px,transparent 1px);
  background-size:16px 16px,var(--col) 100%;
}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
a{color:var(--blue)}
.label{font-size:11px;font-weight:700;line-height:1.2;letter-spacing:1.2px;text-transform:uppercase;color:var(--mute);margin:0 0 24px}
.micro{font-size:10.5px;font-weight:400;line-height:1.2;letter-spacing:.6px;text-transform:uppercase;color:var(--mute)}

/* nav */
nav{display:flex;align-items:center;gap:22px;padding:16px 0;border-bottom:1px dashed var(--rule);flex-wrap:wrap}
.mark{width:26px;height:26px;border:2px solid var(--ink);border-radius:0;display:grid;place-items:center;font-weight:700;font-size:12px;color:var(--ink);text-decoration:none}
nav a.nl{color:var(--ink);text-decoration:none;font-size:12.5px}
nav a.nl:hover{text-decoration:underline}
nav .spacer{margin-left:auto}
nav a.back{color:var(--mute)}

/* header */
.top{padding:56px 0 44px;border-bottom:1px dashed var(--rule)}
h1{font-size:52px;font-weight:700;line-height:1.04;letter-spacing:-1px;margin:0 0 22px}
.lead{max-width:58ch;margin:0;color:var(--mute)}

/* sections */
section{padding:48px 0;border-bottom:1px dashed var(--rule)}

/* session picker, built on the homepage data panel */
.panel{background:#fff;border:1px solid var(--rule)}
.panel .head{display:flex;justify-content:space-between;gap:12px;padding:7px 12px;border-bottom:1px solid var(--rule)}
.rows{display:flex;flex-direction:column}
.row{display:grid;grid-template-columns:1fr auto;column-gap:14px;padding:13px 14px;border-bottom:1px solid var(--rule);text-align:left}
.row:last-child{border-bottom:0}
.row .nm{font-size:13px;font-weight:700;display:flex;align-items:center;gap:7px}
.row .nm i{width:6px;height:6px;border-radius:50%;background:var(--rule);flex:0 0 6px}
.row .sc{font-size:11px;color:var(--mute);text-align:right;align-self:center}
.row .ds{grid-column:1/-1;font-size:11.5px;line-height:1.55;color:var(--mute);margin-top:5px}
.panel .note{border-top:1px solid var(--rule);padding:10px 14px;font-size:11.5px;color:var(--mute)}

.srow{font:inherit;background:#fff;border-left:0;border-right:0;border-top:0;width:100%;cursor:pointer;min-height:44px}
.srow:hover{background:var(--paper)}
.srow.on{background:var(--paper);box-shadow:inset 3px 0 0 var(--blue)}
.srow.on .nm i{background:var(--blue)}
.srow:focus-visible{outline:2px solid var(--blue);outline-offset:-2px}

/* the embed */
.calframe{background:#fff;border:1px solid var(--rule);padding:8px;min-height:620px}
.cal-slot{width:100%}
.cal-slot[hidden]{display:none}
/* Cal sizes the embed by postMessage, and the booker reports a wrong height
   first (measured live: 490 skeleton, then 760, then the true 570), which
   stretched the frame and shoved the footer down for about 400ms. While Cal is
   still loading the slot is locked to the frame's own height so the overshoot
   has nowhere to go; the lock comes off on linkReady, after which Cal resizes
   freely and the taller steps later in the booking flow still work.
   602 = the frame's 620 min-height less its 8px padding and 1px border (the page
   is border-box), 550 the same on mobile. Off by a pixel and the frame still
   settles visibly. */
.cal-slot.pinned{height:602px;overflow:hidden}
.fallback{margin:0;padding:24px;font-size:12.5px;color:var(--mute)}

footer{padding:28px 0 56px;font-size:11.5px;color:var(--mute);border-bottom:0}
.social{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.social a{border:1px solid var(--ink);color:var(--ink);text-decoration:none;padding:7px 12px;font-size:11.5px}
.social a:hover{background:var(--ink);color:var(--paper)}
.fine{margin:0;font-size:11.5px;color:var(--mute)}

@media (max-width:1023px){
  .top{padding:44px 0 36px}
  h1{font-size:40px}
}
@media (max-width:767px){
  :root{--col:64px}
  h1{font-size:34px;letter-spacing:-.6px}
  nav{gap:14px}
  nav .spacer{display:none}
  .calframe{min-height:560px;padding:4px}
  .cal-slot.pinned{height:550px}
}
</style>
</Layout>
