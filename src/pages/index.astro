---
// The real page. Content approved section by section against the working copy at
//   ~/.claude/design/blueprint/site.html
// Keep the two in sync: edit there, then re-port here.
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Iman Emrani"
  description="AI and LLM engineer. I build agents and LLM systems that run on their own."
>
<div class="wrap">

  <nav>
    <span class="mark">IE</span>
    <a class="nl" href="#work">work</a>
    <a class="nl" href="#about">about</a>
    <a class="nl" href="#contact">contact</a>
    <a class="nl" href="/book">book</a>
  </nav>

  <div class="hero">
    <div>
      <h1>Shipped, not demoed.</h1>
      <p class="lead">AI and LLM engineer. I build agents and LLM systems that run on their own, and I work directly with the people who use them.</p>
      <div class="btns">
        <a class="btn p" href="#work">&#9656; see the work</a>
        <a class="btn s" href="/book">book a call</a>
        <a class="btn s" href="mailto:iemrani@icloud.com">email me &rarr;</a>
      </div>
      <p class="status"><i></i>Authorised to work in Italy. Available worldwide as a remote contractor.</p>
    </div>

    <div class="panel">
      <div class="head"><span class="micro">running now</span><span class="micro">2 systems</span></div>
      <div class="rows">
        <div class="row">
          <span class="nm"><i></i>Genova Live</span>
          <span class="sc">continuous</span>
          <span class="ds">News pipeline. Scrapes sources, falls back to an LLM when a scrape fails.</span>
        </div>
        <div class="row">
          <span class="nm"><i></i>Jobwatch</span>
          <span class="sc">daily 07:30</span>
          <span class="ds">Three-lane job scraper. Dedupes, ranks, reports into one funnel.</span>
        </div>
      </div>
      <div class="note">Neither needs a person to start it.</div>
    </div>
  </div>

  <section id="work">
    <p class="label">Selected work</p>
    <div class="cards">
      <div class="card">
        <h3><a class="cl" href="https://iemrani.github.io/campaign-localisation-copilot">Campaign Localisation Copilot &rsaquo;</a></h3>
        <p>Turns a campaign brief and a set of brand guidelines into localised copy for every market and channel, then checks it against the brand rules with a human approval queue and a full audit trail. Deployed and running.</p>
        <p class="meta">fastapi &middot; anthropic sdk &middot; railway <span class="priv live">live</span></p>
      </div>
      <div class="card">
        <h3>Genova Live</h3>
        <p>A Telegram news channel for Persian speakers who have just moved to Genova. It scrapes local sources, and falls back to a language model when a source changes shape or goes down.</p>
        <p class="meta">python &middot; telegram <span class="priv">private</span></p>
      </div>
      <div class="card">
        <h3>Jobwatch</h3>
        <p>Finds AI and machine learning openings across three separate sources, removes the duplicates, scores what is left against one profile, and reports only what is worth reading.</p>
        <p class="meta">sqlite &middot; cron <span class="priv">private</span></p>
      </div>
    </div>
  </section>

  <section id="about">
    <p class="label">About</p>
    <div class="prose">
      <p class="opening">I am a data scientist who moved into building LLM systems. I finished an MSc in Data Science in 2024, and since then most of what I have built has been agents and pipelines that run without anyone watching them.</p>
      <p>The work I care about is the part after the demo: the pipeline that has to survive a source changing shape, the fallback for when a model returns nothing useful, the queue where a person approves what the model wrote. Genova Live and Jobwatch both run on their own schedule, unattended.</p>
      <p>I want to be close to the people who use what I build. The part I would not give up is sitting with someone while they describe what is actually going wrong.</p>
      <p>Based in Italy, authorised to work here, and available worldwide as a remote contractor.</p>
    </div>
  </section>

  <section id="stack">
    <p class="label">What I work with</p>
    <div class="tags">
      <span>python</span><span>anthropic sdk</span><span>openai sdk</span><span>mcp</span>
      <span>claude code</span><span>ollama</span><span>aws</span><span>azure</span>
      <span>sql</span><span>docker</span>
    </div>
  </section>

  <footer id="contact">
    <p class="label">Contact</p>
    <div class="social">
      <a href="https://www.linkedin.com/in/iemrani">linkedin</a>
      <a href="https://github.com/iemrani">github</a>
      <a href="mailto:iemrani@icloud.com">email</a>
      <a href="https://x.com/emranix">x</a>
    </div>
    <p class="fine">&copy; 2026 &middot; built and maintained by hand</p>
  </footer>
</div>

<script is:inline>
  // Fragment links animate the scroll directly. CSS scroll-behavior is honoured on
  // some browsers and silently ignored on others; this makes it consistent.
  function animateTo(top, duration) {
    var start = window.scrollY;
    var delta = top - start;
    var t0 = null;
    function step(ts) {
      if (t0 === null) t0 = ts;
      var p = Math.min((ts - t0) / duration, 1);
      var e = 1 - Math.pow(1 - p, 3);
      window.scrollTo(0, start + delta * e);
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  // Capture phase on the document: runs before any other handler and before the
  // browser's own jump, so nothing downstream can bypass it.
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest && e.target.closest('a[href^="#"]');
    if (!a) return;
    var href = a.getAttribute('href');
    if (!href || href.length < 2) return;
    var target = document.querySelector(href);
    if (!target) return;
    e.preventDefault();
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var top = target.getBoundingClientRect().top + window.scrollY;
    if (reduce) window.scrollTo(0, top);
    else animateTo(top, 480);
    history.pushState(null, '', href);
  }, true);
</script>
</Layout>

<style is:global>
:root{
  --paper:#faf9f7; --ink:#14140f; --mute:#6b6a63; --rule:#e2e0da;
  --dot:#d9d7d0; --blue:#2323e6; --green:#e8f3ea; --red:#fbeaea;
  --col:128px;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0; background:var(--paper); color:var(--ink);
  font:400 13.5px/1.65 "JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;
  background-image:
    radial-gradient(var(--dot) 1px,transparent 1px),
    linear-gradient(90deg,var(--rule) 1px,transparent 1px);
  background-size:16px 16px,var(--col) 100%;
}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
a{color:var(--blue)}
.label{font-size:11px;font-weight:700;line-height:1.2;letter-spacing:1.2px;text-transform:uppercase;color:var(--mute);margin:0 0 24px}
.micro{font-size:10.5px;font-weight:400;line-height:1.2;letter-spacing:.6px;text-transform:uppercase;color:var(--mute)}

/* nav */
nav{display:flex;align-items:center;gap:22px;padding:16px 0;border-bottom:1px dashed var(--rule);flex-wrap:wrap}
.mark{width:26px;height:26px;border:2px solid var(--ink);border-radius:0;display:grid;place-items:center;font-weight:700;font-size:12px}
nav a.nl{color:var(--ink);text-decoration:none;font-size:12.5px}
nav a.nl:hover{text-decoration:underline}
nav .spacer{margin-left:auto}

/* buttons */
.btn{display:inline-flex;align-items:center;font-size:12px;font-weight:700;line-height:1;padding:11px 16px;text-decoration:none;border-radius:0;cursor:pointer;min-height:44px}
.btn.p{background:var(--ink);color:var(--paper);border:0}
.btn.s{background:var(--paper);color:var(--ink);border:1.5px solid var(--ink)}
nav .btn{min-height:0;padding:8px 13px}

/* hero */
.hero{display:grid;grid-template-columns:1fr 1fr;gap:56px;padding:70px 0 60px;border-bottom:1px dashed var(--rule)}
h1{font-size:52px;font-weight:700;line-height:1.04;letter-spacing:-1px;margin:0 0 22px}
.lead{max-width:44ch;margin:0 0 16px}
.sub{max-width:44ch;margin:0 0 28px;color:var(--mute)}
.btns{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.status{font-size:11.5px;color:var(--mute);display:flex;align-items:flex-start;gap:7px}
.status i{margin-top:6px}
.status i{width:7px;height:7px;border-radius:50%;background:var(--ink);flex:0 0 7px}

/* data panel */
.hero>div{min-width:0}
.panel{background:#fff;border:1px solid var(--rule);align-self:start;min-width:0}
.panel .head{display:flex;justify-content:space-between;gap:12px;padding:7px 12px;border-bottom:1px solid var(--rule)}
.rows{display:flex;flex-direction:column}
.row{display:grid;grid-template-columns:1fr auto;column-gap:14px;padding:13px 14px;border-bottom:1px solid var(--rule)}
.row:last-child{border-bottom:0}
.row .nm{font-size:13px;font-weight:700;display:flex;align-items:center;gap:7px}
.row .nm i{width:6px;height:6px;border-radius:50%;background:var(--blue);flex:0 0 6px}
.row .sc{font-size:11px;color:var(--mute);text-align:right;align-self:center}
.row .ds{grid-column:1/-1;font-size:11.5px;line-height:1.55;color:var(--mute);margin-top:5px}
.row .st{display:flex;align-items:center;justify-content:flex-end;gap:6px;font-size:11px;color:var(--blue);margin-top:5px}
.row .st i{width:6px;height:6px;border-radius:50%;background:var(--blue);flex:0 0 6px}
.panel .score{display:flex;gap:22px;padding:16px 14px;align-items:center}
.grade{text-align:center;flex:0 0 auto}
.grade b{display:block;font-size:46px;font-weight:700;line-height:1;color:var(--blue)}
.bars{flex:1;display:flex;flex-direction:column;gap:11px}
.bar-row{display:grid;grid-template-columns:104px 1fr 26px;align-items:center;gap:10px;font-size:11.5px}
.track{height:5px;background:var(--rule)}
.track i{display:block;height:5px;background:var(--blue)}
.bar-row b{font-weight:700;text-align:right}
.panel .note{border-top:1px solid var(--rule);padding:10px 14px;font-size:11.5px;color:var(--mute)}
.diff{border-top:1px solid var(--rule)}
.diff .h{display:flex;justify-content:space-between;gap:12px;padding:7px 12px;border-bottom:1px solid var(--rule)}
.diff pre{margin:0;padding:10px 12px;font-size:11.5px;line-height:1.75;overflow-x:auto}
.diff .del{background:var(--red);display:block}
.diff .add{background:var(--green);display:block}

/* sections */
section{padding:56px 0;border-bottom:1px dashed var(--rule)}
section:last-of-type{border-bottom:0}
.cards{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--rule);background:#fff}
.card{padding:20px;border-right:1px solid var(--rule);min-width:0}
.card:last-child{border-right:0}
.card h3{font-size:16px;font-weight:700;line-height:1.3;margin:0 0 8px}
.card h3 a.cl{color:var(--ink);text-decoration:none}
.card h3 a.cl:hover{text-decoration:underline}
.card p{font-size:12.5px;line-height:1.6;color:var(--mute);margin:0 0 14px}
.card .meta{font-size:11px;color:var(--blue)}
.card .priv{display:inline-block;margin-left:8px;padding:2px 6px;border:1px solid var(--rule);color:var(--mute);font-size:10px;letter-spacing:.6px;text-transform:uppercase}
.card .priv.live{border-color:var(--blue);color:var(--blue)}
.prose{max-width:62ch}
.prose p{margin:0 0 18px}
.prose p:last-child{margin:0;color:var(--mute)}
.prose .opening{font-size:15px;line-height:1.6}
.tags{display:flex;flex-wrap:wrap;gap:7px}
.tags span{background:#fff;border:1px solid var(--ink);padding:6px 10px;font-size:11.5px}
footer{padding:28px 0 56px;font-size:11.5px;color:var(--mute)}
.social{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.social a{border:1px solid var(--ink);color:var(--ink);text-decoration:none;padding:7px 12px;font-size:11.5px}
.social a:hover{background:var(--ink);color:var(--paper)}
.fine{margin:0;font-size:11.5px;color:var(--mute)}

@media (max-width:1023px){
  .hero{grid-template-columns:1fr;gap:40px;padding:52px 0 44px}
  h1{font-size:40px}
  .cards{grid-template-columns:repeat(2,1fr)}
  .card:nth-child(2){border-right:0}
  .card:nth-child(3){border-top:1px solid var(--rule)}
}
@media (max-width:767px){
  :root{--col:64px}
  h1{font-size:34px;letter-spacing:-.6px}
  .cards{grid-template-columns:1fr}
  .card{border-right:0;border-top:1px solid var(--rule)}
  .card:first-child{border-top:0}
  .card:nth-child(3){border-top:1px solid var(--rule)}
  .panel .score{flex-direction:column;align-items:flex-start;gap:14px}
  .bars{width:100%}
  .bar-row{grid-template-columns:88px 1fr 26px}
  nav{gap:14px}
}
</style>
