---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectMention from '../components/ProjectMention.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

const published = projects.filter((project) => project.data.url !== undefined);
const unpublished = projects.filter((project) => project.data.url === undefined);

// The stack row is derived from the projects' own `tech` fields, so it never
// claims anything a project does not declare.
const stack = [
  ...new Set(
    projects.flatMap((project) =>
      (project.data.tech ?? '')
        .split(',')
        .map((item) => item.trim())
        .filter(Boolean)
    )
  ),
];
---

<Layout
  title="Iman Emrani — AI and LLM engineer"
  description="Projects and contact details for Iman Emrani, an AI and LLM engineer based in Italy."
>
  <section id="work">
    <p class="label">Selected work</p>
    <div class="cards">
      {
        published.map((project) => (
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            tech={project.data.tech}
            url={project.data.url!}
            repo={project.data.repo}
          />
        ))
      }
    </div>
  </section>

  {
    unpublished.length > 0 && (
      <section id="also-built">
        <p class="label">Also built</p>
        <ul class="cards">
          {unpublished.map((project) => (
            <ProjectMention title={project.data.title} summary={project.data.summary} />
          ))}
        </ul>
      </section>
    )
  }

  {
    stack.length > 0 && (
      <section id="stack">
        <p class="label">What I work with</p>
        <div class="tags">
          {stack.map((item) => (
            <span>{item}</span>
          ))}
        </div>
      </section>
    )
  }
</Layout>

<style>
  /* card row: one bordered container, children divided by internal 1px rules */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--rule);
    background: #fff;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cards > :global(*) {
    border-right: 1px solid var(--rule);
  }

  .cards > :global(*:last-child) {
    border-right: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tags span {
    background: #fff;
    border: 1px solid var(--ink);
    padding: 6px 10px;
    font-size: 11.5px;
  }

  @media (max-width: 1023px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .cards > :global(*:nth-child(2n)) {
      border-right: 0;
    }

    .cards > :global(*:nth-child(n + 3)) {
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 767px) {
    .cards {
      grid-template-columns: 1fr;
    }

    .cards > :global(*) {
      border-right: 0;
    }

    .cards > :global(* + *) {
      border-top: 1px solid var(--rule);
    }
  }
</style>
