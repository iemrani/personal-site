---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectMention from '../components/ProjectMention.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

const published = projects.filter((project) => project.data.url !== undefined);
const unpublished = projects.filter((project) => project.data.url === undefined);

// The card row must not leave empty columns when there are fewer than three
// published projects; cap the track count at the number actually rendered.
const columns = Math.min(published.length, 3);
---

<Layout
  title="Iman Emrani — AI and LLM engineer"
  description="Projects and contact details for Iman Emrani, an AI and LLM engineer based in Italy."
>
  <section>
    <p class="label">Selected work</p>
    <div class="cards" style={`grid-template-columns: repeat(${columns}, 1fr)`}>
      {
        published.map((project) => (
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            tech={project.data.tech}
            url={project.data.url!}
            repo={project.data.repo}
          />
        ))
      }
    </div>
  </section>

  {
    unpublished.length > 0 && (
      <section>
        <p class="label">Also built</p>
        <ul class="mentions">
          {unpublished.map((project) => (
            <ProjectMention title={project.data.title} summary={project.data.summary} />
          ))}
        </ul>
      </section>
    )
  }
</Layout>

<style>
  /* card-row: one bordered container, children divided by internal rules */
  .cards {
    display: grid;
    background: var(--surface);
    border: 1px solid var(--rule);
  }

  .cards > :global(article) {
    border-right: 1px solid var(--rule);
  }

  .cards > :global(article:last-child) {
    border-right: 0;
  }

  .mentions {
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--rule);
    padding-inline: var(--space-4);
  }

  .mentions > :global(li) {
    max-width: 88ch;
  }

  @media (max-width: 1023px) {
    .cards {
      grid-template-columns: repeat(2, 1fr) !important;
    }

    .cards > :global(article:nth-child(2n)) {
      border-right: 0;
    }

    .cards > :global(article:nth-child(n + 3)) {
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 767px) {
    .cards {
      grid-template-columns: 1fr !important;
    }

    .cards > :global(article) {
      border-right: 0;
    }

    .cards > :global(article + article) {
      border-top: 1px solid var(--rule);
    }
  }
</style>
