---
// One article. Body comes from the markdown in src/content/writing/.
// Figures live in public/writing/<slug>/ and are referenced by absolute path from
// the markdown, so they survive being moved between the draft repo and this one.
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'writing'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={`${post.data.title} — Iman Emrani`} description={post.data.summary}>
<div class="wrap">

  <nav>
    <a class="mark" href="/">IE</a>
    <a class="nl" href="/writing/">writing</a>
    <a class="nl" href="/#work">work</a>
    <a class="nl" href="/#contact">contact</a>
    <span class="spacer"></span>
    <a class="nl back" href="/writing/">&larr; all writing</a>
  </nav>

  <header class="artmast">
    <p class="micro when"><time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt(post.data.date)}</time></p>
    <h1>{post.data.title}</h1>
  </header>

  <article class="article">
    <Content />
  </article>

  <div class="endcap">
    <a class="btn s" href="/writing/">&larr; all writing</a>
  </div>

  <footer>
    <p class="label">Contact</p>
    <div class="social">
      <a href="https://www.linkedin.com/in/iemrani">linkedin</a>
      <a href="https://github.com/iemrani">github</a>
      <a data-u="iman" data-d="iemrani.com">email</a>
      <a href="https://x.com/emranix">x</a>
    </div>
    <p class="fine">&copy; 2026 &middot; built and maintained by hand</p>
  </footer>
</div>

<script is:inline>
  document.querySelectorAll('a[data-u][data-d]').forEach(function (a) {
    var addr = a.dataset.u + String.fromCharCode(64) + a.dataset.d;
    a.href = 'mail' + 'to:' + addr;
    if (a.dataset.show === 'addr') a.textContent = addr;
  });
</script>
</Layout>

<style is:global>
/* Reading pages run in a narrower frame than the home page: at 1120 the text column
   is stranded against the left edge of a wide screen. 960 also fits a figure at its
   full 900px without the figure looking like it escaped the layout. */
.wrap{max-width:960px}

.artmast{padding:70px 0 36px;border-bottom:1px dashed var(--rule)}
.artmast .when{margin:0 0 14px}
.artmast h1{font-size:44px;font-weight:700;line-height:1.08;letter-spacing:-1px;margin:0;max-width:22ch}

/* The article body.

   The measure is set per element, NOT on .article. Capping the container instead
   would cap the figures with it, and a 900px diagram squeezed into a 68ch column
   is unreadable. */
.article{padding:44px 0 8px;max-width:none}
.article p,
.article h2,
.article blockquote,
.article hr{max-width:68ch}
.article p{margin:0 0 20px;font-size:14px;line-height:1.75}
.article h2{
  font-size:13px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;
  color:var(--mute);margin:52px 0 18px;padding-top:0;
}
.article h2:first-child{margin-top:0}
.article strong{font-weight:700;color:var(--ink)}
.article em{font-style:italic}
.article a{color:var(--blue)}

/* Pulled quote: the source being examined, not decoration. */
.article blockquote{
  margin:0 0 20px;padding:14px 18px;background:#fff;
  border:1px solid var(--rule);border-left:3px solid var(--blue);
}
.article blockquote p{margin:0;font-size:13.5px;color:var(--ink)}

/* Section rules. The markdown uses --- between sections. */
.article hr{border:0;border-top:1px dashed var(--rule);margin:44px 0}

/* Figures. In the markdown the image and its caption sit on adjacent lines, so they
   render as ONE paragraph: <p><img><em>caption</em></p>. Style that paragraph as the
   figure block. Do not reach for `p:has(img) + p`: there is no following paragraph.
   An .svg image arrives here already inlined as <svg> (src/plugins/inline-svg.mjs). */
.article p:has(> :is(img, svg)){max-width:none;width:min(100%,900px);margin:0 0 32px}
.article p:has(> :is(img, svg)) > :is(img, svg){
  display:block;width:100%;height:auto;margin:0 0 10px;
  border:1px solid var(--rule);background:#fff;
}
/* Inlined figures sit on the page's own dot grid, framed in the accent blue instead
   of a paper card. The grid's COLUMN lines are left out on purpose: through a
   diagram they read as connectors. The canvas-filling rect is the figure's own
   background; CSS fill beats the attribute, so the source and its PNG export keep it. */
.article p:has(> svg) > svg{
  background:var(--paper) radial-gradient(var(--dot) 1px,transparent 1px) 0 0/16px 16px;
  border:1.5px solid rgba(35,35,230,.55);
}
.article svg rect[width="100%"][height="100%"]{fill:none}
.article p:has(> :is(img, svg)) em{
  display:block;font-style:normal;font-size:11.5px;line-height:1.55;
  color:var(--mute);max-width:74ch;
}

/* Type inside inlined figures. Sizes are SVG user units on the 1000-unit canvas, so
   they scale with the figure. Copied from ~/.claude/design/blueprint/fig.css (the
   canonical scale; change it there first, then here). Floor is 9.5. */
.article svg{
  --fig-h1:17;--fig-title:15;--fig-title-tight:13.5;
  --fig-label:11.5;--fig-meta:11;--fig-stamp:9.5;
}
.article svg text{font-family:"JetBrains Mono",ui-monospace,monospace}
.article svg .fig-h1{font-size:calc(var(--fig-h1) * 1px)}
.article svg .fig-title{font-size:calc(var(--fig-title) * 1px);font-weight:600}
.article svg .fig-title-tight{font-size:calc(var(--fig-title-tight) * 1px);font-weight:600}
.article svg .fig-label{font-size:calc(var(--fig-label) * 1px)}
.article svg .fig-meta{font-size:calc(var(--fig-meta) * 1px)}
.article svg .fig-stamp{font-size:calc(var(--fig-stamp) * 1px)}

.endcap{padding:20px 0 8px;border-top:1px dashed var(--rule);border-bottom:1px dashed var(--rule);margin-bottom:8px}
.endcap{display:flex;padding:24px 0}

nav a.back{color:var(--mute)}

@media (max-width:767px){
  .artmast{padding:48px 0 28px}
  .artmast h1{font-size:28px;letter-spacing:-.6px}
  .article{padding:32px 0 8px}
  .article p{font-size:13.5px}
  .article h2{margin:40px 0 16px}

  /* Figures. Each is drawn on a 1000-unit canvas, so at phone width the labels
     would land near 4px. Hold the figure at 700px and let it scroll sideways
     instead. The caption is in the same paragraph, so it would inherit that
     700px: pin it to the scrollport and cap it to the screen. */
  .article p:has(> :is(img, svg)){overflow-x:auto;-webkit-overflow-scrolling:touch}
  .article p:has(> :is(img, svg)) > :is(img, svg){min-width:700px}
  .article p:has(> :is(img, svg)) em{
    position:sticky;left:0;width:calc(100vw - 48px);max-width:74ch;
  }
}
</style>
